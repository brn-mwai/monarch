\newlabel{fig:pervertex}{{3}{7}{Predicted response for one fear-activating item at every one of the 20{,}484 cortical vertices, on the pial surface. Vertices below the map's 70th percentile are left unpainted so the anatomy remains readable, and the threshold is stated in the figure. This is the encoder's own output, not a smoothed or interpolated field}{figure.3}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Agreement between two scanning sessions over all 400 items. ICC is reported beside $r$ because a session that shifted every score by a constant would still correlate perfectly.}}{7}{table.3}\protected@file@percent }
