\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Landau free energy $F(m)$ at $\beta J = 0.7$, evaluated at each category's measured mean $X$ for assumed couplings $\alpha \in \{-1, -0.5, 0, 0.5, 1\}$. At this coupling the model is below its critical point and each curve has a single minimum; the panels show how little the category means tilt it. The sweep is not a fit: no value of $\alpha $ is estimated from the data.}}{13}{figure.5}\protected@file@percent }
\newlabel{fig:freeenergy}{{5}{13}{Landau free energy $F(m)$ at $\beta J = 0.7$, evaluated at each category's measured mean $X$ for assumed couplings $\alpha \in \{-1, -0.5, 0, 0.5, 1\}$. At this coupling the model is below its critical point and each curve has a single minimum; the panels show how little the category means tilt it. The sweep is not a fit: no value of $\alpha $ is estimated from the data}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces The field bound evaluated at three reduced couplings (grid points of the companion paper's solver nearest $1.1$, $1.5$ and $2$), using the measured spread $\Delta X = 0.1241$ of run A. Each row states the coupling any proposal of this mechanism would need in order for media to drive a transition through this observable.}}{14}{table.6}\protected@file@percent }
\newlabel{tab:bound}{{6}{14}{The field bound evaluated at three reduced couplings (grid points of the companion paper's solver nearest $1.1$, $1.5$ and $2$), using the measured spread $\Delta X = 0.1241$ of run A. Each row states the coupling any proposal of this mechanism would need in order for media to drive a transition through this observable}{table.6}{}}
