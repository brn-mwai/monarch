*.tsbuildinfo
next-env.d.ts

# Build
/build
/out
/coverage
/uploads

# Vendored Meta TRIBE v2 repo (has its own .git; installed via pip install -e .)
services/inference/tribev2/

# Paper 1 figures: regenerated deterministically by scripts/phase_boundary.py, and the
# numbers behind them are committed as phase_boundary.json, which is what a reviewer checks.
services/inference/data/paper1/*.png
services/inference/data/paper1/*.pdf
services/inference/data/paper1/*.svg

# Surface figures: regenerated by scripts/render_brain_figures.py from the scan CSV.
services/inference/data/figures/*.png
services/inference/data/figures/*.pdf
services/inference/data/figures/*.svg

# Partial-scan working data. The scan output lives on Kaggle as a dataset version, and
# report figures derived from an unfinished corpus read as finished ones.
services/inference/data/partial50/


# Cloudflare Pages local secrets. Never committed: this file holds real API keys.
.dev.vars
**/.dev.vars

# wrangler build scratch
apps/web/.wrangler/
